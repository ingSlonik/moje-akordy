{
  "name": "moje-akordy",
  "version": "2.0.0",
  "description": "",
  "scripts": {
    "start": "node --env-file=.env dist-server/index.js",
    "dev": "concurrently --kill-others \"npm run server:dev\" \"npm run fe:dev\"",
    "server:dev": "tsx watch --env-file=.env --exclude \"cache/**\" --exclude \"easy-db/**\" --exclude \"easy-db-files/**\" --exclude \"easy-db-backup/**\" server/index.tsx",
    "fe:dev": "vite",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server/index.tsx --bundle --platform=node --target=node24 --outfile=dist-server/index.js --packages=external",
    "test": "node --import tsx --env-file=.env --test --test-concurrency=1 tests/*.test.ts",
    "deploy": "node scripts/deploy.ts"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "cors": "^2.8.6",
    "easy-analytics": "^1.0.1",
    "easy-db-node": "^3.1.0",
    "easy-image-resizer": "^2.0.1",
    "easy-page-router": "^1.0.1",
    "easy-user-auth": "^1.2.0",
    "express": "^5.2.1",
    "nodemailer": "^7.0.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ssr-hook": "^0.2.0",
    "typed-client-server-api": "^1.1.0",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.2",
    "node-ssh": "^13.2.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.0",
    "vite": "^8.1.5"
  }
}